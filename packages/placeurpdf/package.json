{
  "name": "placeurpdf",
  "version": "0.0.1",
  "description": "CLI tool to generate PDFs from text files using placeur layout",
  "type": "module",
  "bin": {
    "placeurpdf": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "placeur": "^0.0.1",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
